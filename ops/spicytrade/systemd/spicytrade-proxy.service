# The local brokerage credential broker for an agent on this machine. Install it with
#   spicytrade setup     (from a checkout: ./ops/spicytrade/spicytrade.mjs setup)
# which writes this file to ~/.config/systemd/user/ with ExecStart replaced by this install's own
# node and proxy.mjs, both by absolute path, and enables it. The ExecStart below is only what a
# hand copy into a checkout at this path would run.
# Credentials are read from the OS keyring once, at startup, so nothing secret lives in this
# unit, in the environment block, or in any argv. Restart the unit after changing them.
[Unit]
Description=spicytrade agent proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/github.com/ferdousbhai/spicytrade/ops/spicytrade/proxy.mjs
Restart=on-failure
RestartSec=5
# The keyring is unlocked per login session, so this follows the session rather than the boot.
# A keyring that cannot be read, a missing spicytrade token, or a keyring holding both kinds of
# tastytrade credential exits non-zero and is restarted. A
# missing brokerage credential is not a failure: the proxy starts and forwards the market and
# research tools only, and the Worker refuses account tools with its own message.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
